<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive icon of Trap (Android 8 and later).

    The foreground carries the unmodified Trap icon artwork resized to fit
    cleanly inside the 72dp safe zone so launcher masks never clip the
    lettering; the dark background layer prevents legacy white-disc wrapping.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
