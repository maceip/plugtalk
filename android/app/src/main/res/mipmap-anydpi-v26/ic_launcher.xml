<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive icon of Trap (Android 8+, with Android 13+ monochrome layer).

    - background: deep obsidian-plum (#0D080B) matching the V3 shutter shadow
    - foreground: unmodified V3 cutout fitted inside the 72dp safe zone
    - monochrome: shutter-striped TR/AP glyph mask for Material You themed icons
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
