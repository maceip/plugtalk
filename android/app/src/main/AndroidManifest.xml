<?xml version="1.0" encoding="utf-8"?>
<!--
    Trap Android Manifest.

    Chromium's isolated renderer, GPU, and network child-process services are
    contributed by the Cefrium SDK AAR manifest merger (`:sandboxed_process0..39`
    and `:privileged_process0..2`). `TrapApplication` checks `getProcessName()`
    and skips Arti Tor / Rust / browser initialization inside child processes.

    Window & lifecycle configuration:
      * `android:enableOnBackInvokedCallback="true"` hands system back gestures
        to `PredictiveBackHandler` so live visual page snapshots render smoothly.
      * `android:launchMode="singleTask"` keeps Trap in a single browser task.
      * `android:configChanges` preserves active `CefriumBrowser` surfaces and
        Tor circuits across rotation, split-screen resize, and theme switches.
      * `android:windowSoftInputMode="adjustResize"` works with Compose edge-to-edge
        `WindowInsets` (`statusBars`, `navigationBars`, `ime`) so bottom chrome
        and sheets never collide with system bars or the soft keyboard.
      * `android:memtagMode="off"` keeps Zygote, `app_zygote`, `:privileged_process*`,
        and `:sandboxed_process*` in ARM64 TBI (`MEMTAG_OFF`) so ARMv9 `FEAT_MTE`
        devices with locked MTE never trigger Chromium 156 `PartitionAlloc` /
        Bionic `SetHeapTaggingLevel` (`set_tcf_on_all_threads`) `SIGTRAP` (`brk #0`).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for Arti Tor circuits and Chromium NetworkChangeNotifier. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Optional hardware-backed biometric unlock for the local OpenPGP keyring. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Android 15+ (API 35) screen-recording state callback for sensitive overlay masking. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />

    <!-- Android 17+ (API 37) explicit local-network gate for user-initiated RFC1918/mDNS navigation. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Strip unnecessary phone-state, legacy storage, C2DM push, AICore, and
         system-only CredentialManager permissions merged from transitive AARs. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" tools:node="remove" />
    <uses-permission android:name="com.google.android.apps.aicore.service.BIND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_SET_ORIGIN" tools:node="remove" />
    <uses-permission android:name="android.permission.CREDENTIAL_MANAGER_QUERY_CANDIDATE_CREDENTIALS" tools:node="remove" />

    <application
        android:name=".TrapApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:memtagMode="off"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Trap"
        android:usesCleartextTraffic="false">

        <!-- Ensure transitive Firebase / Play components never auto-initialize. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
