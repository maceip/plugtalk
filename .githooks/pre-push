#!/usr/bin/env bash
#
# Git `pre-push` hook for Trap (`core.hooksPath = .githooks`).
#
# Runs `scripts/pre-push-gate.sh` (fail-closed) before any non-`[skip ci]` push.
# Activate once per clone with:
#   git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export GIT_PAGER=cat
ZERO_OID="0000000000000000000000000000000000000000"

if [[ "${PRE_PUSH_FORCE:-0}" == "1" ]]; then
    exec "$REPO_ROOT/scripts/pre-push-gate.sh"
fi

if [[ -t 0 ]]; then
    # Invoked interactively from a terminal rather than by `git push`: verify HEAD.
    HEAD_MSG="$(git -C "$REPO_ROOT" log -1 --format=%B HEAD 2>/dev/null || true)"
    if [[ "$HEAD_MSG" == *"[skip ci]"* ]]; then
        echo "[pre-push] HEAD commit carries [skip ci]; skipping full local CI gate (set PRE_PUSH_FORCE=1 to run anyway)."
        exit 0
    fi
    exec "$REPO_ROOT/scripts/pre-push-gate.sh"
fi

total_lines=0
non_delete_oids=()
needs_gate=0

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ -z "${local_ref:-}" && -z "${local_oid:-}" ]]; then
        continue
    fi
    total_lines=$(( total_lines + 1 ))

    # Deleting a remote branch/tag pushes local_oid = 0000...; nothing to build/test.
    if [[ "$local_oid" == "$ZERO_OID" || "$local_oid" =~ ^0+$ ]]; then
        continue
    fi

    non_delete_oids+=("$local_oid")
    commit_msg="$(git -C "$REPO_ROOT" log -1 --format=%B "$local_oid" 2>/dev/null || true)"
    if [[ "$commit_msg" != *"[skip ci]"* ]]; then
        needs_gate=1
    fi
done

if (( total_lines == 0 )); then
    # If invoked manually with `< /dev/null` and no `git push` remote args, gate HEAD;
    # if invoked by `git push <remote> <url>` when all refs are already up to date, exit 0.
    if (( $# == 0 )); then
        HEAD_MSG="$(git -C "$REPO_ROOT" log -1 --format=%B HEAD 2>/dev/null || true)"
        if [[ "$HEAD_MSG" == *"[skip ci]"* ]]; then
            echo "[pre-push] HEAD commit carries [skip ci]; skipping full local CI gate."
            exit 0
        fi
        exec "$REPO_ROOT/scripts/pre-push-gate.sh"
    fi
    exit 0
fi

if (( ${#non_delete_oids[@]} == 0 )); then
    # Remote ref deletion only.
    exit 0
fi

if (( needs_gate == 0 )); then
    echo "[pre-push] All pushed commit(s) carry [skip ci]; skipping full local CI gate."
    exit 0
fi

exec "$REPO_ROOT/scripts/pre-push-gate.sh"
